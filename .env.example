# NBA DFS Optimizer - Environment Configuration Example
# Copy this file to .env and update the paths to match your local setup

# Directory where the main slate's projection CSV files (NBA-Projs-*.csv) are stored.
# Other slate types read the sibling folder <NBA_PROJS_DIR>-<type> (e.g. projections-night).
NBA_PROJS_DIR=/path/to/projections

# Optional: a slate type's projections folder when it isn't that sibling (O-15).
# One per type: NBA_PROJS_DIR_EARLY, _TURBO, _AFTERNOON, _NIGHT, _LATE.
# NBA_PROJS_DIR_NIGHT=/path/to/night-projections

# Optional: an extra DKEntries candidate outside NBA_DOWNLOADS_DIR. The run
# uses the chosen --entries file, or the newest matching DKEntries*.csv download.
# NBA_ENTRIES_PATH=/path/to/DKEntries.csv

# Directory where intermediate lineup pools and ranked lineups will be stored
NBA_LINEUP_DIR=/path/to/lineup-exports

# Directory where the final upload-ready CSVs will be saved
NBA_OUTPUT_DIR=/path/to/downloads

# Nightly capture (O-0). Leave values unquoted or in single quotes: inside
# double quotes python-dotenv turns \n, \t etc. into control characters.
# Root for per-slate folders (<root>/<date>_classic_<type>/). Unset keeps the legacy exports/ layout.
NBA_DATA_ROOT=/path/to/NBA-26-27-Slates
# Where DKEntries and Stok exports land; searched for the auto-picked DKEntries and by
# `nba-dfs-capture finalize` (default ~/Downloads)
NBA_DOWNLOADS_DIR=/path/to/downloads